# Set MOCK=false to use real adapters (Stripe, course generator, email)
# Default is mock mode — safe to run with no keys.
MOCK=true

# Stripe (used when MOCK=false). See STRIPE_INTEGRATION.md
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# App origin used for Stripe success/cancel URLs
APP_URL=http://localhost:3000
